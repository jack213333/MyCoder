# 忽略所有 .pyc 文件
*.pyc

# 忽略整个目录
.memdir/
.memdir_test/
__pycache__/
venv/
.venv/
.idea/
.pytest_cache/
.ruff_cache/
logo/
A2A_EX_Problem/
openspec/
data/
src/crawler/
src/spider/
src/chicken_farm/

# ── 敏感文件 ──
# API 密钥配置文件（本地填写真实 key，模板见 config/model_key.yaml.example）
config/model_key.yaml

# ── 本地 / 运行时生成文件 ──
.myclaude/settings.local.json
.init_file_record.json
.init_record.json
testdata.txt

# 忽略这些目录下的所有内容
code_output/*
context/*
log/*
spec/*
tests/*
token_statistics/*

# 但是保留这些目录本身（通过.gitkeep）
!code_output/.gitkeep
!context/.gitkeep
!log/.gitkeep
!spec/.gitkeep
!spec/mycoder_test_spec.md
!spec/unit_test_spec_origin.txt
!tests/.gitkeep
!token_statistics/.gitkeep

# memory有点复杂，单独列

# 忽略 memory_storage 目录下的所有内容
memory_storage/*

# 保留 memory_storage 下的 memory_ex 目录
!memory_storage/memory_ex/

# 忽略 memory_ex 目录下的所有内容
memory_storage/memory_ex/*

# 保留 bug_base 和 raw_memory 目录本身
!memory_storage/memory_ex/bug_base/
!memory_storage/memory_ex/raw_memory/

# 忽略这两个目录下的所有内容
memory_storage/memory_ex/bug_base/*
memory_storage/memory_ex/raw_memory/*

# 但保留这两个目录下的 .gitkeep 文件
!memory_storage/memory_ex/bug_base/.gitkeep
!memory_storage/memory_ex/raw_memory/.gitkeep
