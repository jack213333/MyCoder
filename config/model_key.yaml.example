# 模型 API Key 配置模板
# 使用方法：复制本文件为 model_key.yaml，然后填入你自己的 API Key：
#   copy config\model_key.yaml.example config\model_key.yaml
# 注意：model_key.yaml 已被 .gitignore 忽略，请勿将真实 Key 提交到版本控制

# DeepSeek API 连接参数
DeepSeek:
  api_key: "your_deepseek_api_key_here"
  base_url: "https://api.deepseek.com"
  model_name: "deepseek-v4-pro"

# MiniMax API 连接参数
MiniMax:
  api_key: "your_minimax_api_key_here"
  base_url: "https://api.minimaxi.com/v1"
  model_name: "MiniMax-M2.7"

# ============================================================
# memory_1 模型配置（向量化 + LLM 压缩）
#   说明：memory 模块独立于 MyCoder 主循环。
#   provider 字段引用上方 MiniMax / DeepSeek 配置节的
#   api_key 和 base_url，无需在此重复配置。
# ============================================================
memory_1:
  embedding:
    provider: "MiniMax"
    model_name: "embo-01"
  llm:
    provider: "DeepSeek"
    model_name: "deepseek-chat"

# ============================================================
# memory_2 模型配置（LLM 直接召回 + 压缩）
#   说明：provider 引用上方 DeepSeek 配置节的 api_key / base_url，
#   无需在此重复配置。
# ============================================================
memory_2:
  llm:
    provider: "DeepSeek"
    model_name: "deepseek-chat"

# 模型基本参数
model:
  provider: "DeepSeek"
